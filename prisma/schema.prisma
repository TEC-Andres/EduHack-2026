// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_DATABASE_URL") // migrations can't go through the pgbouncer pooler
}

model User {
    id        Int       @id @default(autoincrement())
    email     String    @unique
    password  String? // null for Google-only accounts
    name      String?
    image     String?
    role      String    @default("User")
    createdAt DateTime  @default(now())
    sessions  Session[]
    teams     TeamMember[]
    projects  Project[]
    assigned  Activity[]
}

model Team {
    id        Int          @id @default(autoincrement())
    name      String
    createdAt DateTime     @default(now())
    members   TeamMember[]
    projects  Project[]
}

model TeamMember {
    teamId Int
    userId Int
    role   String @default("member") // "owner" | "member"
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([teamId, userId])
}

model Project {
    id               Int               @id @default(autoincrement())
    name             String
    description      String            @default("")
    brief            String            @default("") // AI-expanded version of the idea (expand_idea skill)
    rubricText       String            @default("") // rubric pasted by the user (e.g. course/hackathon rubric)
    sprintLengthDays Int               @default(7)
    ownerId          Int
    owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    teamId           Int?
    team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
    createdAt        DateTime          @default(now())
    activities       Activity[]
    sprints          Sprint[]
    criteria         RubricCriterion[]
}

model Sprint {
    id         Int        @id @default(autoincrement())
    projectId  Int
    project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
    name       String
    goal       String     @default("")
    startDate  DateTime
    endDate    DateTime
    activities Activity[]
}

model RubricCriterion {
    id          Int        @id @default(autoincrement())
    projectId   Int
    project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
    name        String
    description String     @default("")
    weight      Int        @default(0) // percent
    levels      Json       @default("[]") // [{ label, points, description }]
    activities  Activity[]
}

// An "issue" in GitHub Projects terms: one academic activity / deliverable.
model Activity {
    id          Int              @id @default(autoincrement())
    projectId   Int
    project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
    number      Int
    title       String
    description String           @default("")
    acceptance  String[]         @default([])
    deliverable String           @default("")
    status      String           @default("backlog") // backlog | todo | in_progress | review | done
    priority    String           @default("medium") // low | medium | high | urgent
    points      Int?
    labels      String[]         @default([])
    checklist   Json             @default("[]") // [{ text, done }]
    position    Float            @default(0)
    dueDate     DateTime?
    sprintId    Int?
    sprint      Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
    assigneeId  Int?
    assignee    User?            @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
    criterionId Int?
    criterion   RubricCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt

    @@unique([projectId, number])
    @@index([projectId, status])
}

model Session {
    token     String   @id
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    expiresAt DateTime
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
}
